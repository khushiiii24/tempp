# Copy to .env and fill in. Nothing in this repo sends anything for real by default.

# A real Anthropic API key (starts with sk-ant-). Without it, run with --llm stub.
ANTHROPIC_API_KEY=sk-ant-...

# Phase 7 only. Razorpay TEST mode credentials.
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...

# Must be set to "1" *in addition* to passing --live before anything actually sends.
DEDUCTION_DESK_ALLOW_LIVE=0
